{
  "info": {
    "name": "Car Tracker API",
    "description": "Postman collection for the Car Tracker Laravel API. Set `base_url` and `token` collection variables before running protected requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "car-tracker-collection-001"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "brand_id", "value": "1", "type": "string" },
    { "key": "car_model_id", "value": "1", "type": "string" },
    { "key": "car_id", "value": "1", "type": "string" },
    { "key": "user_id", "value": "1", "type": "string" },
    { "key": "role_id", "value": "1", "type": "string" },
    { "key": "permission_name", "value": "manage-cars", "type": "string" },
    { "key": "item_id", "value": "1", "type": "string" },
    { "key": "service_id", "value": "1", "type": "string" },
    { "key": "service_center_id", "value": "1", "type": "string" },
    { "key": "document_id", "value": "1", "type": "string" },
    { "key": "fill_up_id", "value": "1", "type": "string" },
    { "key": "parking_record_id", "value": "1", "type": "string" }
